NODE_ENV=production
PORT=3001
# Dominios del frontend que consumen el QR
# ALLOWED_ORIGINS=https://crm.tudominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Webhooks opcionales de n8n. En local, déjalos vacíos para no reenviar
