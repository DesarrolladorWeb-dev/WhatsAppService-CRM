NODE_ENV=production
PORT=3001
# Dominios del frontend que consumen el QR
# ALLOWED_ORIGINS=https://crm.tudominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Secreto que protege los endpoints del servicio (mínimo 32 caracteres).
WHATSAPP_SERVICE_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# Secreto compartido con n8n/CRM; se envía en el header x-n8n-secret del webhook.
WHATSAPP_WEBHOOK_SECRET=
# URL base del CRM
CRM_URL=http://localhost:3000
# Webhook del CRM que recibe los mensajes entrantes (se carga al arrancar)
CRM_WEBHOOK_URL=

# Webhooks opcionales de n8n. En local, déjalos vacíos para no reenviar
# mensajes a los flujos externos/de producción.
TRIGGER_N8N_URL=
TRIGGER_N8N_OUTGOING_URL=
